# Project-local .npmrc. Overrides the global `~/.npmrc` for this repo.
#
# The global `~/.npmrc` sets `ignore-scripts=true` for security, which
# prevents ALL postinstall scripts from running. We need specific
# dependencies (electron, esbuild, bufferutil, etc.) to run their
# postinstall scripts to download native binaries. pnpm's
# `onlyBuiltDependencies` allowlist only takes effect when scripts are
# enabled, so we disable `ignore-scripts` locally and let the allowlist
# gate which scripts actually run.
#
# `side-effects-cache=false` prevents pnpm from caching the symlink
# rewrites that break `electron`'s postinstall (`node-install.js` walks
# realpaths and fails on the cached symlinks).
ignore-scripts=false
side-effects-cache=false
