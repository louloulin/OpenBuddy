# Project-local .npmrc. Overrides the global `~/.npmrc` for this repo.
#
# The global `~/.npmrc` sets `ignore-scripts=true` for security, which
# prevents ALL postinstall scripts from running. We need specific
# dependencies (electron, esbuild, bufferutil, etc.) to run their
# postinstall scripts to download native binaries. pnpm's
# `onlyBuiltDependencies` allowlist only takes effect when scripts are
# enabled, so we disable `ignore-scripts` locally and let the allowlist
# gate which scripts actually run.
#
# `side-effects-cache=false` prevents pnpm from caching the symlink
# rewrites that break `electron`'s postinstall (`node-install.js` walks
# realpaths and fails on the cached symlinks).
ignore-scripts=false
side-effects-cache=false
# pnpm + electron-builder asar is broken for transitive deps that only
# live in .pnpm/<hash>/node_modules/ (electron-builder can't follow the
# symlink chain at packaging time, and asar symlinks don't survive
# electron's runtime fs). Switching to a hoisted, npm-style layout makes
# every top-level dep reachable from `node_modules/<pkg>/` so the
# @earendil-works/pi-coding-agent runtime deps (cross-spawn, cors,
# ajv, express, openai, debug, ...) end up in app.asar. The trade-off
# is a flat node_modules (no .pnpm virtual store) — slower install but
# reliable packaging.
node-linker=hoisted
public-hoist-pattern[]=*
# Copy real files into node_modules/<pkg>/ instead of creating symlinks
# to the .pnpm virtual store. Without this, electron-builder follows the
# symlink during packaging and writes a regular file, but that file is the
# symlink target — when the asar is extracted the relative path is broken
# (the symlink target no longer exists in the asar's coordinate system).
# `hardlink` would also work but inflates the on-disk install footprint.
package-import-method=copy
