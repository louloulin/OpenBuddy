# Project-local .npmrc. Overrides the global `~/.npmrc` for this repo.
#
# The global `~/.npmrc` sets `ignore-scripts=true` for security, which
# prevents ALL postinstall scripts from running. We need specific
# dependencies (electron, esbuild, bufferutil, etc.) to run their
# postinstall scripts to download native binaries. pnpm's
# `allowBuilds` allowlist (pnpm-workspace.yaml) only takes effect when
# scripts are enabled, so we disable `ignore-scripts` locally and let the
# allowlist gate which scripts actually run.
ignore-scripts=false

# ---------------------------------------------------------------------------
# Everything else that used to live here moved to `pnpm-workspace.yaml`.
#
# pnpm 11 stopped reading project-structural settings from `.npmrc`:
# `node-linker`, `public-hoist-pattern`, `package-import-method` and
# `side-effects-cache` are silently ignored when written here, which is how
# `node-linker=hoisted` quietly stopped applying and Electron installers
# started shipping without pnpm's transitive dependencies. `.npmrc` is now
# reserved for auth / registry / network settings only.
# ---------------------------------------------------------------------------
