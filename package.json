{
  "name": "openbuddy",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "description": "OpenBuddy — an Electron desktop workspace powered by Pi.",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:electron": "pnpm build && pnpm typecheck:electron && node scripts/build-electron.mjs",
    "dist": "pnpm dist:electron",
    "dist:electron": "pnpm build:electron && electron-builder --publish never",
    "pack:electron": "pnpm build:electron && electron-builder --dir --publish never",
    "dist:win": "pnpm dist:electron --win nsis",
    "dist:mac": "pnpm dist:electron --mac dmg",
    "test": "vitest run",
    "audit:ipc": "node scripts/audit-contract.mjs",
    "test:electron-ui": "node scripts/electron-ui-check.mjs",
    "git:push": "bash scripts/git-push.sh",
    "git:push:tags": "bash scripts/git-push.sh --tags",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:electron",
    "check:boundaries": "node tools/check-boundaries.mjs --check",
    "verify:e2e": "node tools/verify/e2e-shots.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "katex": "^0.18.1",
    "linkify-it": "^6.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/linkify-it": "^5.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.21.5",
    "jsdom": "^29.1.1",
    "playwright-core": "1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  }
}
