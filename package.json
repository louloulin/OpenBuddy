{
  "name": "openbuddy",
  "version": "0.14.0",
  "description": "OpenBuddy - a WorkBuddy-style desktop shell, built on Electron + moon.",
  "main": "./out/main/index.js",
  "bin": {
    "openbuddy": "./bin/openbuddy",
    "openbuddy-cli": "./bin/openbuddy-cli.mjs"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "moon run openbuddy:dev.electron",
    "dev:renderer": "moon run openbuddy:dev.renderer",
    "build": "moon run openbuddy:build",
    "preview": "moon run openbuddy:preview",
    "start": "moon run openbuddy:electron.start",
    "typecheck": "moon run openbuddy:typecheck",
    "lint": "moon run openbuddy:lint",
    "test": "moon run openbuddy:test",
    "storage:drill": "node scripts/storage/run-storage-drill.mjs",
    "storage:preflight": "vitest run --config vitest.config.ts packages/runtime/openbuddy-storage/src/__tests__/preflight-cli.test.ts --reporter=dot",
    "brand:icons": "node scripts/brand/gen-icons.mjs",
    "storage:inventory": "node scripts/storage/run-source-inventory.mjs",
    "storage:boundaries": "node scripts/storage/check-architecture-boundaries.mjs",
    "storage:acceptance": "node scripts/storage/run-architecture-acceptance.mjs",
    "test:electron": "moon run openbuddy:electron.smoke",
    "test:electron:ui": "playwright test --ui",
    "test:electron:report": "playwright show-report playwright-report",
    "test:electron:surface": "node scripts/electron/surface-regression.mjs",
    "test:electron:real-ui": "node scripts/electron/real-ui-smoke.mjs",
    "test:electron:expert-graph": "node scripts/electron/expert-graph-smoke.mjs",
    "test:electron:ipc-surface": "node scripts/electron/ipc-surface-smoke.mjs",
    "test:electron:email-ipc-surface": "node scripts/electron/email-ipc-surface-smoke.mjs",
    "test:electron:real-evals": "node scripts/electron/launch-real-evals-echo.mjs",
    "perf:streaming": "node scripts/perf/streaming-bench.mjs",
    "perf:ipc": "node scripts/perf/ipc-latency.mjs",
    "perf": "node scripts/perf/streaming-bench.mjs && node scripts/perf/ipc-latency.mjs",
    "eval:email-external": "node scripts/electron/launch-harness.mjs -- node evals/node/run_external_email_capability.mjs",
    "eval:email-provider-profiles": "vitest run packages/capability/openbuddy-email/src/index.test.ts -t \"mainstream provider profile\"",
    "eval:email-ai-contract": "node evals/node/validate_email_ai_contract.mjs",
    "test:electron:harness": "moon run openbuddy:electron.harness-smoke",
    "test:electron:audit": "node scripts/electron/audit-agent-surface.mjs",
    "test:closed-loop": "node scripts/electron/closed-loop-capability-eval.mjs",
    "eval:audit": "node evals/node/audit_evaluation_suite.mjs",
    "eval:capabilities": "node evals/node/audit_capability_matrix.mjs",
    "eval:capability-evidence": "node evals/node/audit_capability_evidence.mjs",
    "eval:official-audit": "node evals/node/audit_official_benchmarks.mjs",
    "eval:benchmark-evidence": "node evals/node/audit_benchmark_evidence.mjs",
    "eval:evidence-audit": "node evals/node/audit_evidence_artifacts.mjs",
    "eval:acceptance": "node evals/node/run_full_acceptance.mjs",
    "clean": "moon clean",
    "electron:dev": "moon run openbuddy:dev.electron",
    "electron:start": "moon run openbuddy:electron.start",
    "electron:build": "moon run openbuddy:electron.build",
    "electron:build:win": "moon run openbuddy:electron.build.win",
    "electron:build:mac": "moon run openbuddy:electron.build.mac.dir",
    "electron:release:mac": "moon run openbuddy:electron.build.mac",
    "electron:build:linux": "moon run openbuddy:electron.build.linux",
    "app:typecheck": "moon run app-desktop:typecheck",
    "app:lint": "moon run app-desktop:lint",
    "workspace:typecheck": "moon run \\*:typecheck",
    "workspace:test": "moon run \\*:test",
    "commercial:audit": "node scripts/audit-commercial-model.mjs --config deploy/openbuddy-commercial-model.example.json",
    "enterprise:release-audit": "node scripts/audit-enterprise-release.mjs",
    "tenant:boundary-audit": "bash scripts/verify-tenant-boundaries.sh",
    "moon:sync": "moon sync projects",
    "moon:graph": "moon project-graph --json",
    "moon:query": "moon query projects",
    "git:push": "bash scripts/git-push.sh",
    "git:push:tags": "bash scripts/git-push.sh --tags",
    "eval:email-ai-quality": "node evals/node/evaluate_email_ai_quality.mjs",
    "test:email-ai-quality": "vitest run evals/node/evaluate_email_ai_quality.test.mjs",
    "email:imap-smtp": "node scripts/email/imap-smtp-mcp-server.mjs",
    "eval:email-imap-readonly": "node evals/node/run_imap_smtp_readonly.mjs",
    "test:email-imap-smtp": "vitest run scripts/email/imap-smtp-core.test.mjs",
    "test:email-imap-smtp-mcp": "vitest run scripts/email/imap-smtp-mcp-server.test.mjs",
    "eval:email-imap-smtp": "node evals/node/run_imap_smtp_acceptance.mjs",
    "eval:email-gmail-api": "node evals/node/run_gmail_api_acceptance.mjs",
    "eval:email-graph-api": "node evals/node/run_graph_api_acceptance.mjs",
    "eval:email-jmap-api": "node evals/node/run_jmap_api_acceptance.mjs",
    "eval:gaia-local": "node evals/node/run_gaia_local.mjs",
    "eval:agentbench-tools-local": "node evals/node/run_agentbench_tools.mjs",
    "eval:agentdojo-safety-local": "node evals/node/run_agentdojo_safety.mjs",
    "eval:top-tier-local": "node evals/node/run_top_tier_local.mjs",
    "test:top-tier-local": "vitest run evals/node/agent_benchmark_adapters.test.mjs",
    "eval:coverage-report": "node evals/node/coverage_report.mjs",
    "eval:mt-bench-style": "node evals/node/run_mt_bench_style.mjs",
    "eval:bfcl-style": "node evals/node/run_bfcl_style.mjs",
    "test:closed-loop:full": "node scripts/electron/closed-loop-capability-eval-full.mjs",
    "eval:nl2bash-style": "node evals/node/run_nl2bash_style.mjs",
    "eval:swe-bench-style": "node evals/node/run_swe_bench_style.mjs",
    "electron:dir:mac": "moon run openbuddy:electron.build.mac.dir",
    "electron:dir:win": "moon run openbuddy:electron.build.win.dir",
    "electron:dir:linux": "moon run openbuddy:electron.build.linux.dir",
    "electron:release:win": "moon run openbuddy:electron.release.win",
    "electron:release:linux": "moon run openbuddy:electron.release.linux",
    "electron:build:all": "moon run openbuddy:electron.build.all",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "postinstall": "moon sync projects || true",
    "sync:ui-aliases": "node scripts/sync-ui-aliases.mjs"
  },
  "dependencies": {
    "@cordisjs/core": "^3.18.1",
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@openbuddy/auth-permission": "workspace:*",
    "@openbuddy/bundle-base": "workspace:*",
    "@openbuddy/capability-authorization": "workspace:*",
    "@openbuddy/capability-calendar": "workspace:*",
    "@openbuddy/capability-email": "workspace:*",
    "@openbuddy/capability-mcp-client": "workspace:*",
    "@openbuddy/collaboration-coordinator": "workspace:*",
    "@openbuddy/collaboration-evidence": "workspace:*",
    "@openbuddy/collaboration-inbox": "workspace:*",
    "@openbuddy/collaboration-network": "workspace:*",
    "@openbuddy/collaboration-policy": "workspace:*",
    "@openbuddy/collaboration-protocol": "workspace:*",
    "@openbuddy/collaboration-room": "workspace:*",
    "@openbuddy/collaboration-task": "workspace:*",
    "@openbuddy/cordis": "workspace:*",
    "@openbuddy/core-session": "workspace:*",
    "@openbuddy/fs-fs-local": "workspace:*",
    "@openbuddy/logging-main": "workspace:*",
    "@openbuddy/logging-renderer": "workspace:*",
    "@openbuddy/logging-shared": "workspace:*",
    "@openbuddy/plugin-host": "workspace:*",
    "@openbuddy/renderer-host": "workspace:*",
    "@openbuddy/storage": "workspace:*",
    "@openbuddy/team-team": "workspace:*",
    "bufferutil": "^4.1.0",
    "katex": "^0.18.1",
    "linkify-it": "^6.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.16.0",
    "pi-goal-list-loop-audit": "^0.38.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "utf-8-validate": "^6.0.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.5.3",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/linkify-it": "^5.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.9",
    "electron-vite": "5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "1.58.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "repository": {
    "type": "git",
    "url": "https://github.com/louloulin/OpenBuddy.git"
  },
  "homepage": "https://github.com/louloulin/OpenBuddy",
  "bugs": {
    "url": "https://github.com/louloulin/OpenBuddy/issues"
  }
}
