# OpenBuddy Casdoor Resource Gateway — production environment.
# Copy to `.env.production`, fill in real values, and pass via
# `docker compose --env-file .env.production -f docker-compose.production.yml up -d`.
# All secrets should come from a secret manager (Vault, AWS SM, SOPS, etc.).

# --- Casdoor issuer / client -----------------------------------------------
RESOURCE_GATEWAY_VERSION=release-identifier
CASDOOR_ISSUER=https://casdoor.example.com
CASDOOR_AUDIENCE=openbuddy
# Optional internal exchange for WeKnora. Keep this value identical to the WeKnora secret and never commit a real secret.
# RESOURCE_GATEWAY_WEKNORA_EXCHANGE_SECRET=replace-with-openssl-rand-hex-32
RESOURCE_GATEWAY_WEKNORA_EXCHANGE_AUDIENCE=weknora
# Explicit Casdoor organization -> existing WeKnora numeric tenant mapping; never auto-create in production.
# RESOURCE_GATEWAY_WEKNORA_TENANT_MAP_JSON={"your-casdoor-org":123}
CASDOOR_JWKS_URI=https://casdoor.example.com/.well-known/jwks
# Optional RSA public key for encrypting sensitive resource metadata at rest.
# Keep the PEM in a secret manager; do not commit a private key.
# RESOURCE_GATEWAY_CASDOOR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Shared HMAC secret for Casdoor → gateway webhooks ---------------------
RESOURCE_GATEWAY_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
RESOURCE_GATEWAY_BILLING_CALLBACK_SECRET=replace-with-openssl-rand-hex-32
RESOURCE_GATEWAY_BACKCHANNEL_LOGOUT_SECRET=replace-with-openssl-rand-hex-32

# --- New API upstream (kept only by the gateway, never sent to OpenBuddy UI) -
NEW_API_BASE_URL=https://new-api.example.com
NEW_API_GROUP=default
# JSON object mapping every tenant Group to a dedicated New API token.
NEW_API_GROUP_TOKENS_JSON='{"default":"replace-with-dedicated-token","team":"replace-with-dedicated-token"}'
# JSON capability directory verified against the actual New API channel. Every
# supported billable protocol must use usage=required and a real YYYY-MM-DD
# verification date; unsupported protocols may be listed with supported=false.
NEW_API_CAPABILITIES_JSON='{"default":{"MiniMax-M3":{"chat.completions":{"supported":true,"streaming":true,"usage":"required","verifiedAt":"YYYY-MM-DD"}}}}'
# Production always requires real upstream usage for settlement.
NEW_API_ALLOW_ESTIMATED_USAGE=0
# RESOURCE_GATEWAY_AI_REPLAY_MAX_BYTES=10000000
# RESOURCE_GATEWAY_AI_REQUEST_LEASE_MS=120000
# RESOURCE_GATEWAY_AI_REQUEST_REPLAY_TTL_MS=86400000

# --- Postgres (internal to the docker network) -----------------------------
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# --- Caddy reverse proxy ----------------------------------------------------
ACME_EMAIL=admin@example.com
GATEWAY_DOMAIN=gateway.example.com

RESOURCE_GATEWAY_NEW_API_COST_IMPORT_SECRET=replace-with-openssl-rand-hex-32

# --- Optional SIEM sink -----------------------------------------------------
# Set RESOURCE_GATEWAY_SIEM to `syslog`, `webhook`, or `csv`.
# RESOURCE_GATEWAY_SIEM=webhook
# RESOURCE_GATEWAY_SIEM_ENDPOINT=https://siem.example.com/audit-ingest
