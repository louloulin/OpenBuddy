# OpenBuddy Website — environment variables example
# Copy to .env.local for local dev. None are required for the website to build.

# Canonical origin used for canonical tags, hreflang, sitemap and robots
# (read in src/lib/constants.ts). Leave unset in production — the code falls
# back to https://openbuddy.dev. Set it on a preview deploy so the preview
# advertises its own origin instead of pointing crawlers at production.
# NEXT_PUBLIC_SITE_URL=https://openbuddy-preview.vercel.app

# Optional analytics (not enabled by default — uncomment to enable)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=openbuddy.dev
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Algolia DocSearch (optional — for in-site search)
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
# NEXT_PUBLIC_ALGOLIA_INDEX=openbuddy