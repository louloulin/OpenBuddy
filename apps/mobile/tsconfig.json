{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@openbuddy/protocol/*": ["../../packages/protocol/src/*"],
      "@openbuddy/client/*": ["../../packages/client/src/*"],
      "@openbuddy/chat-core/*": ["../../packages/chat-core/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
