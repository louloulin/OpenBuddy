{
  "expo": {
    "name": "OpenBuddy",
    "slug": "openbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openbuddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openbuddy.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "扫描桌面端二维码完成配对，以及拍摄图片发送给桌面会话。",
        "NSFaceIDUsageDescription": "解锁 OpenBuddy。",
        "NSMicrophoneUsageDescription": "语音输入消息。",
        "NSSpeechRecognitionUsageDescription": "把语音转成文字发送给桌面会话。"
      }
    },
    "android": {
      "package": "com.openbuddy.mobile",
      "permissions": ["CAMERA", "RECORD_AUDIO", "USE_BIOMETRIC", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "扫描桌面端二维码完成配对，以及拍摄图片发送给桌面会话。"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "gatewayUrl": ""
    }
  }
}
