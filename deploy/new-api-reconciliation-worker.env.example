# Copy to /etc/openbuddy/new-api-reconciliation-worker.env and inject values
# from a secret manager. Never commit the populated file.
NEW_API_BASE_URL=https://new-api.example.com
NEW_API_ADMIN_ACCESS_TOKEN=replace-with-short-lived-read-only-admin-token
NEW_API_ADMIN_USER_ID=replace-with-current-admin-user-id
# New API login response data.session.sid; required when session validation is enabled.
NEW_API_ADMIN_SESSION_ID=replace-with-session-id-if-required
# Omit explicit bounds for a rolling window on every timer invocation.
NEW_API_LOG_WINDOW_MINUTES=60
# Scheduled runs replay this overlap to tolerate delayed New API log visibility;
# Gateway importKey/newApiRequestId idempotency prevents double charging.
NEW_API_LOG_OVERLAP_MINUTES=10
# Successful scheduled runs advance this non-secret state file atomically.
NEW_API_RECONCILIATION_CHECKPOINT_FILE=/var/lib/openbuddy/new-api-reconciliation-checkpoint.json
# Last run state for monitoring and release readiness; this is not a secret.
NEW_API_RECONCILIATION_STATUS_FILE=/var/lib/openbuddy/new-api-reconciliation-status.json
# Watchdog uses a separate non-secret unit configuration; this value is the freshness limit.
NEW_API_RECONCILIATION_MAX_AGE_HOURS=26
# For a one-off backfill, set both values instead:
# NEW_API_LOG_SINCE=2026-01-01T00:00:00Z
# NEW_API_LOG_UNTIL=2026-01-01T01:00:00Z
# Enterprise mapping schema (recommended):
# {"groups":{"default":{"tenantId":"tenant-a"}},"users":{"alice":{"tenantId":"tenant-a","subject":"casdoor-subject","group":"default"}},"subjects":{"casdoor-subject":{"tenantId":"tenant-a","subject":"casdoor-subject","group":"default"}},"tokens":{"57":{"tenantId":"tenant-a","subject":"casdoor-subject","group":"default"}}}
# When groups are present, every log must carry a known group and the worker
# cross-checks token/user/subject/group tenant and subject before importing a cost.
# The old flat {"username":{"tenantId":"...","subject":"..."}} shape remains supported for migration only.
NEW_API_TENANT_SUBJECT_MAP_JSON=@/etc/openbuddy/new-api-tenant-subject-map.json
NEW_API_COST_SOURCE=new-api-log
NEW_API_COST_CURRENCY=USD
# If set, the worker compares this value with /api/status.data.quota_per_unit.
# Keep the migration override disabled; enabling it bypasses that equality gate
# and must be approved and recorded for the migration window.
# NEW_API_QUOTA_PER_UNIT=500000
NEW_API_ALLOW_QUOTA_UNIT_OVERRIDE=0
OPENBUDDY_GATEWAY_URL=https://gateway.example.com
OPENBUDDY_GATEWAY_ACCESS_TOKEN=replace-with-worker-service-token
RESOURCE_GATEWAY_NEW_API_COST_IMPORT_SECRET=replace-with-hmac-secret
NEW_API_RECONCILIATION_WRITE=1
# In write mode any unmapped, unpriced, or request-id-less log fails the run;
# checkpoint is not advanced until every fetched log is accepted.
# Production write mode defaults both controls to strict. Keep them explicit
# in deployment manifests so Group drift and legacy flat mappings fail closed.
NEW_API_STRICT_TENANT_MAPPING=1
NEW_API_VALIDATE_GROUPS=1

# Read-only capability drift snapshot. The snapshot contains only
# model/group/channel identifiers and status metadata; it never writes New API.
NEW_API_CAPABILITY_SNAPSHOT_OUTPUT=/var/lib/openbuddy/new-api-capability-snapshot.json
# NEW_API_CAPABILITY_INCLUDE_LOG_STATS=1
# NEW_API_EXPECTED_GROUPS=default,enterprise-ai
# NEW_API_EXPECTED_MODELS=MiniMax-M3
# NEW_API_EXPECTED_CHANNELS=2
# Write mode requires this release/deploy gate. It only reads the redacted
# snapshot file and rejects stale or drifted execution inventory before import.
NEW_API_CAPABILITY_SNAPSHOT_FILE=/var/lib/openbuddy/new-api-capability-snapshot.json
# NEW_API_CAPABILITY_MAX_AGE_HOURS=24
NEW_API_CAPABILITIES_JSON=@/etc/openbuddy/new-api-capabilities.json
# validate with: node scripts/validate-new-api-capability-snapshot.mjs
