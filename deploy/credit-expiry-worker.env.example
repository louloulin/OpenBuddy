# Copy to /etc/openbuddy/credit-expiry-worker.env and inject values from a secret manager.
# Never commit the populated file or the signing secret.
OPENBUDDY_GATEWAY_URL=https://gateway.example.com
RESOURCE_GATEWAY_CREDIT_EXPIRY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Explicit allowlist. The worker refuses to run when this is missing or empty.
CREDIT_EXPIRY_TENANT_IDS=tenant-a,tenant-b
CREDIT_EXPIRY_STATUS_FILE=/var/lib/openbuddy/credit-expiry-status.json
