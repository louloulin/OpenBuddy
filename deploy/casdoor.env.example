# OpenBuddy · Casdoor Enterprise Identity 环境变量模板
#
# 把本文件复制为 `.env` 或 `.env.local` 并填入真实凭据;
# 切勿把填好的文件提交进 git。
#
# 选择顺序:`OPENBUDDY_CASDOOR_PROFILE` → `OPENBUDDY_CASDOOR_ISSUER` → 用户持久化 → 进程内默认。
# 默认 profile(`dev`)只在 NODE_ENV != "production" 时生效;生产构建强制走 `selfHosted` 占位。
# 因此生产部署**必须**显式设置下列变量,不能依赖任何内置默认值。

# --- Profile 切换(可选) ---
# 取值:dev | selfHosted
# 作用:仅决定"如果未设置 OPENBUDDY_CASDOOR_ISSUER 时"使用哪一组默认值。
OPENBUDDY_CASDOOR_PROFILE=dev

# --- 必填:核心端点 ---
# Casdoor 服务入口(OIDC issuer),必须以 http(s):// 开头、不带尾部斜杠。
OPENBUDDY_CASDOOR_ISSUER=https://casdoor.example.com
# OIDC 应用 client id;在 Casdoor 后台 Applications 中创建后获得。
OPENBUDDY_CASDOOR_CLIENT_ID=your-application-client-id
# 桌面应用回调地址;Casdoor 端需要登记相同的 URL。
OPENBUDDY_CASDOOR_REDIRECT_URI=casdoor://localhost/callback
# Casdoor 管理后台地址,默认 `${ISSUER}/`。
OPENBUDDY_CASDOOR_MANAGEMENT_URL=https://casdoor.example.com/

# --- 可选:OIDC 范围与第三方登录 hint ---
# 空格分隔,需包含 openid。
OPENBUDDY_CASDOOR_SCOPE="openid profile email phone offline_access"
# 短信登录 Provider 名称 hint
OPENBUDDY_CASDOOR_SMS_HINT="Verification code"
# 微信登录 Provider 名称 hint
OPENBUDDY_CASDOOR_WECHAT_HINT=Wechat
# Casbin enforcer id,用于 Resource Gateway 端策略映射。
OPENBUDDY_CASDOOR_ENFORCER_ID=openbuddy-resource-gateway

# --- Resource Gateway(独立服务,可与 Casdoor 同源也可分离部署) ---
# Resource Gateway 暴露 Prometheus 指标 / Token 内省 / Audit 端点;
#  OpenBuddy 通过 OIDC client_credentials 拉取 service token。
# 一般指向 /api/v1/resource 或部署者自定的网关前缀。
OPENBUDDY_RESOURCE_GATEWAY_URL=https://casdoor-resource-gateway.example.com

# --- 开发与诊断 ---
# 把 OIDC 流程写到 stdout,便于本地调试。
OPENBUDDY_CASDOOR_DEBUG=1
# 把 Resource Gateway 调用写到 stdout。
OPENBUDDY_RESOURCE_GATEWAY_DEBUG=0
