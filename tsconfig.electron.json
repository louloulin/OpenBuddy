{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "electron/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "packages/protocol/src/**/*.ts",
    "packages/services/src/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/host/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
